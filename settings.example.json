{
  "$comment": "Trecho representativo do meu ~/.claude/settings.json (nivel user). Ajustei os caminhos e removi permissoes especificas de projetos privados — nao copie o allowlist as cegas, revise pro seu proprio fluxo.",
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"$HOME/.claude/statusline/statusline.mjs\"",
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "caveman@caveman": true
  },
  "extraKnownMarketplaces": {
    "impeccable": {
      "source": { "source": "github", "repo": "pbakaus/impeccable" }
    },
    "caveman": {
      "source": { "source": "github", "repo": "JuliusBrussee/caveman" }
    }
  },
  "language": "Brazillian Portuguese",
  "effortLevel": "xhigh",
  "advisorModel": "opus",
  "theme": "dark",
  "editorMode": "normal",
  "preferredNotifChannel": "terminal_bell",
  "autoCompactEnabled": true,
  "terminalProgressBarEnabled": true
}
